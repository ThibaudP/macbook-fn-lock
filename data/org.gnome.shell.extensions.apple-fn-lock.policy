<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>MacBook Fn Lock</vendor>
  <action id="org.gnome.shell.extensions.apple-fn-lock.set-mode">
    <description>Change Apple keyboard Fn Lock</description>
    <description xml:lang="fr">Changer le verrouillage Fn du clavier Apple</description>
    <message>Change the Apple keyboard function key mode</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
